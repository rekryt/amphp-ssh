{
    "name": "amphp/ssh",
    "homepage": "https://github.com/amphp/ssh",
    "description": "Async SSH client for PHP based on Amp.",
    "keywords": [
        "ssh",
        "ssh2",
        "client",
        "async",
        "amp",
        "amphp"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Joel Wurtz",
            "email": "jwurtz@jolicode.com"
        },
        {
            "name": "Sergey Krupkin",
            "email": "rekrytkw@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "amphp/amp": "^3.1",
        "amphp/byte-stream": "^2.1",
        "amphp/file": "^4.0",
        "amphp/pipeline": "^1.2",
        "amphp/socket": "^2.4",
        "paragonie/sodium_compat": "^1.21 || ^2.0",
        "psr/log": "^3",
        "revolt/event-loop": "^1"
    },
    "require-dev": {
        "amphp/phpunit-util": "^3",
        "friendsofphp/php-cs-fixer": "^3",
        "monolog/monolog": "^3",
        "phpunit/phpunit": "^9"
    },
    "autoload": {
        "psr-4": {
            "Amp\\Ssh\\": "src"
        },
        "files": [
            "src/functions.php",
            "src/Transport/functions.php",
            "src/KeyExchange/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Amp\\Ssh\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text --coverage-clover build/logs/clover.xml",
        "lint": "php-cs-fixer fix --diff --dry-run -v"
    }
}
